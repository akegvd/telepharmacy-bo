# Base URL the app fetches tasks from. Defaults to the built-in mock API at
# /api/tasks (see README) when unset — only override this if you're running
# json-server locally instead, e.g. NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=/api

# Shows the sticky dev API control panel (add a random task / reset from db.json)
# and enables the endpoints behind it. Only the exact value `true` turns it on, in
# every environment including Vercel; anything else — or leaving it unset — keeps it
# off. Requires NEXT_PUBLIC_API_URL to point at the built-in in-memory API, since
# json-server has no reset endpoint.
NEXT_PUBLIC_ENABLE_DEV_API_CONTROLS=true

# Server-only credentials for the "Ask about your data" chat assistant (src/app/api/chat).
# Deliberately NOT prefixed NEXT_PUBLIC_ so they never reach the client bundle. Any
# OpenAI-compatible /chat/completions provider works — for a free demo key, try Groq
# (https://console.groq.com/keys, base URL below) or OpenRouter's free-tier models.
# Leaving CHAT_LLM_API_KEY unset makes the chat endpoint respond with 503.
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://api.groq.com/openai/v1
CHAT_LLM_MODEL=llama-3.3-70b-versatile
